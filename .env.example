# PostgreSQL connection string. Local development uses node-postgres; Vercel
# deployments use Neon Serverless WebSocket transactions when VERCEL=1.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shell

# At least 32 random bytes, encoded as base64url or hex.
SESSION_SECRET=replace-with-a-long-random-secret

# Reserved for the dormant OpenAI chat feature. The persistent shell does not
# make OpenAI requests.
OPENAI_API_KEY=
